  InputLines:
    - '// @ui {"widget":"label", "label":"Room Invaders — encounter controller"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 hud {"hint":"Passive world-space UI"}'
    - '// @input SceneObject boxSpawn {"hint":"Room object 1 surface anchor"}'
    - '// @input SceneObject doorSpawn {"hint":"Room object 2 surface anchor"}'
    - '// @input SceneObject shelfSpawn {"hint":"Room object 3 surface anchor"}'
    - '// @input SceneObject rescueSpot {"hint":"Movable Pip rescue anchor"}'
    - '// @input Asset.Material material {"hint":"Imported vertex-color material"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float duration = 90 {"hint":"Round duration in seconds", "widget":"slider", "min":15, "max":180, "step":1}'
    - '// @input float rescueAt = 30 {"hint":"Rescue trigger in seconds", "widget":"slider", "min":5, "max":120, "step":1}'
    - '// @input float rescueWindow = 22 {"hint":"Seconds allowed to free Pip", "widget":"slider", "min":5, "max":60, "step":1}'
    - '// @input float cooldown = 0.22 {"hint":"Minimum seconds between shots", "widget":"slider", "min":0.1, "max":1, "step":0.01}'
    - '// @input float health = 5 {"hint":"Starting shield count", "widget":"slider", "min":1, "max":20, "step":1}'
    - '// @input float spawnInterval = 2.7 {"hint":"Early seconds between spawns", "widget":"slider", "min":1, "max":8, "step":0.1}'
    - '// @input float lateSpawnInterval = 2.1 {"hint":"Seconds between spawns after rescue", "widget":"slider", "min":1, "max":8, "step":0.1}'
    - '// @input float enemyLifetime = 6.5 {"hint":"Early seconds until escape", "widget":"slider", "min":3, "max":15, "step":0.5}'
    - '// @input float lateEnemyLifetime = 5.5 {"hint":"Late seconds until escape", "widget":"slider", "min":3, "max":15, "step":0.5}'
    - '// @input float emergence = 2 {"hint":"Untargetable emergence time", "widget":"slider", "min":0.2, "max":2, "step":0.05}'
    - '// @input float warningLead = 0.9 {"hint":"Directional audio lead before visible emergence", "widget":"slider", "min":0.4, "max":2, "step":0.05}'
    - '// @input float peekPeriod = 2.2 {"hint":"Peeker animation cycle", "widget":"slider", "min":1, "max":5, "step":0.1}'
    - '// @input float peekVisible = 1.5 {"hint":"Visible portion of each peek cycle", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float hitPoints = 100 {"hint":"Base points per invader", "widget":"slider", "min":10, "max":500, "step":10}'
    - '// @input float comboStep = 20 {"hint":"Extra points per combo step", "widget":"slider", "min":0, "max":100, "step":5}'
    - '// @input float comboCap = 5 {"hint":"Maximum combo bonus steps", "widget":"slider", "min":0, "max":10, "step":1}'
    - '// @input float lockPoints = 50 {"hint":"Points per lock", "widget":"slider", "min":0, "max":200, "step":10}'
    - '// @input float rescuePoints = 500 {"hint":"Bonus for selecting freed Pip", "widget":"slider", "min":0, "max":2000, "step":50}'
    - '// @input float sfxVolume = 0.3 {"hint":"Immediate feedback volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float musicVolume = 0.06 {"hint":"Quiet looping music volume", "widget":"slider", "min":0, "max":0.4, "step":0.01}'
    - '// @input vec4 violet = "{0.66,0.34,1,1}" {"hint":"Invader and cage color", "widget":"color"}'
    - '// @input vec4 mint = "{0.32,1,0.72,1}" {"hint":"Pip color", "widget":"color"}'
    - '// @input vec4 wood = "{0.35,0.24,0.46,1}" {"hint":"Prop color", "widget":"color"}'
